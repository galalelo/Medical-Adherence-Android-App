<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Possible Overdose Report" android:textColor="#000000" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="This form records details and connects you to official guidance. It does not diagnose an overdose. Do not delay emergency care." android:textColor="#444444" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#FFF4F4" android:padding="14dp" android:text="If the person collapses, has a seizure, has trouble breathing, or cannot be awakened, call emergency services immediately." android:textColor="#6B2323" android:textStyle="bold" />
        <AutoCompleteTextView android:id="@+id/etReportMedication" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:completionThreshold="2" android:hint="Medication or substance" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#000000" android:textColorHint="#666666" />
        <EditText android:id="@+id/etReportAmount" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="Estimated amount taken" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#000000" android:textColorHint="#666666" />
        <EditText android:id="@+id/etReportWhen" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:hint="When did it happen?" android:inputType="datetime" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#000000" android:textColorHint="#666666" />
        <EditText android:id="@+id/etReportSymptoms" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="12dp" android:gravity="top" android:hint="Symptoms or other details" android:inputType="textMultiLine" android:padding="12dp" android:textColor="#000000" android:textColorHint="#666666" />
        <Button android:id="@+id/btnSaveOverdoseReport" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:backgroundTint="#C43B3B" android:text="SAVE REPORT AND SHOW HELP" android:textColor="#FFFFFF" android:textStyle="bold" />
        <Button android:id="@+id/btnCallPoisonControl" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:backgroundTint="#1976D2" android:text="CALL POISON CONTROL (U.S.)" android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
